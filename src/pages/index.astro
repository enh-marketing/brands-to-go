<style>
  /* ─── RESET & VARIABLES ─── */
  :root {
    --red: #E31837;
    --red-deep: #B8102B;
    --red-light: #FF2E4D;
    --mild-red: #C04050;
    --cream: #FFF8F5;
    --charcoal: #1A1A1A;
    --warm-gray: #6B6262;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--cream);
    color: var(--charcoal);
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }

  /* ─── HERO ─── */
  .hero {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    animation: heroReveal 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
  }

  @keyframes heroReveal {
    from {
      transform: scale(1.08);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  /* ─── HERO SOCIAL BAR ─── */
  .hero-social {
    position: absolute;
    right: 1.5rem;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    z-index: 5;
    opacity: 0;
    animation: cueFade 0.8s ease-out 1.8s forwards;
  }

  .hero-social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #fff;
    transition: background 0.3s ease, transform 0.3s ease;
  }

  .hero-social a:hover {
    background: #fff;
    color: var(--red);
    transform: scale(1.15);
  }

  .hero-social svg {
    display: block;
  }

  /* ─── SCROLL CUE ─── */
  .scroll-cue {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    color: #fff;
    text-decoration: none;
    opacity: 0;
    animation: cueFade 0.8s ease-out 1.4s forwards, cueBounce 2.2s ease-in-out 2.2s infinite;
    cursor: pointer;
    z-index: 5;
    transition: opacity 0.3s ease;
  }

  .scroll-cue.cue-hidden {
    opacity: 0;
    pointer-events: none;
    animation: none;
  }

  .scroll-label {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .scroll-cue svg {
    display: block;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.25));
  }

  @keyframes cueFade {
    to { opacity: 1; }
  }

  @keyframes cueBounce {
    0%, 100% { transform: translate(-50%, 0); }
    50% { transform: translate(-50%, 8px); }
  }

  /* ─── LOCATIONS SECTION ─── */
  .locations {
    position: relative;
    background: var(--cream);
    padding: 5rem 1.5rem 4rem;
  }

  .locations::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--red), var(--red-light), var(--red));
  }

  .locations-inner {
    max-width: 960px;
    margin: 0 auto;
  }

  .locations-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .pill {
    display: inline-block;
    background: var(--red);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 0.5rem 1.6rem;
    border-radius: 100px;
    margin-bottom: 1.5rem;
  }

  .locations-header h2 {
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    font-size: clamp(2rem, 5vw, 3rem);
    color: var(--charcoal);
    line-height: 1.15;
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }

  .subtitle {
    font-size: 1.05rem;
    color: var(--warm-gray);
    max-width: 400px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* ─── LOCATION CARDS ─── */
  .locations-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1.25rem;
  }

  /* Row 1 — both Abu Dhabi cards span 3 cols each (2 across) */
  .location-card:nth-child(1),
  .location-card:nth-child(2) {
    grid-column: span 3;
  }

  /* Row 2 — Dubai, RAK, Ajman span 2 cols each (3 across) */
  .location-card:nth-child(3),
  .location-card:nth-child(4),
  .location-card:nth-child(5) {
    grid-column: span 2;
  }

  .location-card {
    position: relative;
    background: #fff;
    border: 1px solid rgba(227, 24, 55, 0.08);
    border-radius: 16px;
    padding: 2rem 1.5rem;
    text-align: center;
    transition: transform 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                box-shadow 0.35s ease,
                border-color 0.35s ease;
  }

  .location-card.is-opening {
    border-color: rgba(227, 24, 55, 0.35);
    box-shadow: 0 6px 24px rgba(227, 24, 55, 0.08);
  }

  /* Anchor variant — keep card visuals identical to div cards */
  a.location-card--link {
    color: inherit;
    text-decoration: none;
    cursor: pointer;
  }

  .location-card--link:hover {
    border-color: rgba(227, 24, 55, 0.5);
    box-shadow: 0 16px 48px rgba(227, 24, 55, 0.16);
  }

  .map-cue {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.32rem;
    margin-top: 0.7rem;
    color: var(--red);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    transition: gap 0.25s ease;
  }

  .location-card--link:hover .map-cue {
    gap: 0.5rem;
  }

  .map-cue svg {
    flex-shrink: 0;
  }

  /* ─── BADGES ─── */
  .badge {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    display: inline-block;
    padding: 0.32rem 0.7rem;
    border-radius: 100px;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    line-height: 1;
    white-space: nowrap;
  }

  .badge-opening {
    background: var(--red);
    color: #fff;
    box-shadow: 0 2px 10px rgba(227, 24, 55, 0.35);
    animation: badgePulse 2.4s ease-in-out infinite;
  }

  .badge-coming {
    background: rgba(227, 24, 55, 0.07);
    color: var(--red);
    border: 1px solid rgba(227, 24, 55, 0.18);
    font-size: 0.5rem;
    padding: 0.25rem 0.55rem;
    letter-spacing: 0.11em;
  }

  @keyframes badgePulse {
    0%, 100% {
      box-shadow: 0 2px 10px rgba(227, 24, 55, 0.35);
    }
    50% {
      box-shadow: 0 2px 18px rgba(227, 24, 55, 0.55);
    }
  }

  .location-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(227, 24, 55, 0.1);
    border-color: rgba(227, 24, 55, 0.2);
  }

  .pin-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(227, 24, 55, 0.06);
    color: var(--red);
    margin-bottom: 1rem;
    transition: background 0.3s ease, transform 0.3s ease;
  }

  .location-card:hover .pin-icon {
    background: var(--red);
    color: #fff;
    transform: scale(1.1);
  }

  .location-card h3 {
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--charcoal);
    margin-bottom: 0.3rem;
  }

  .city {
    font-size: 0.9rem;
    color: var(--warm-gray);
    font-weight: 500;
  }

  /* ─── FOOTER ─── */
  .footer {
    text-align: center;
    padding: 2.5rem 1.5rem 2rem;
    background: var(--red);
    color: rgba(255, 255, 255, 0.95);
    font-size: 0.8rem;
    letter-spacing: 0.03em;
  }

  .footer-social {
    display: flex;
    justify-content: center;
    gap: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .footer-social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
    transition: background 0.3s ease, transform 0.3s ease;
  }

  .footer-social a:hover {
    background: #fff;
    color: var(--red);
    transform: scale(1.12);
  }

  .footer-social svg {
    display: block;
  }

  /* ─── ENTRY ANIMATIONS ─── */
  .anim-fade {
    opacity: 0;
    transform: translateY(28px);
    animation: fadeSlideUp 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
    animation-delay: var(--delay, 0s);
  }

  @keyframes fadeSlideUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ─── MOBILE ─── */
  @media (max-width: 768px) {
    .locations {
      padding: 3rem 1.25rem 2.5rem;
    }

    .locations-header {
      margin-bottom: 2.5rem;
    }

    .locations-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .location-card:nth-child(n) {
      grid-column: auto;
    }

    .location-card {
      padding: 1.5rem 1.25rem 1rem;
      display: flex;
      align-items: center;
      text-align: left;
      gap: 1rem;
    }

    .pin-icon {
      margin-bottom: 0;
      flex-shrink: 0;
      width: 46px;
      height: 46px;
    }

    .location-card h3 {
      font-size: 1.05rem;
    }

    .badge {
      top: 0.6rem;
      right: 0.6rem;
      font-size: 0.55rem;
      padding: 0.28rem 0.6rem;
      letter-spacing: 0.12em;
    }

    .badge-coming {
      font-size: 0.46rem;
      padding: 0.22rem 0.5rem;
    }

    /* Map cue: drop to its own line below the title/city on mobile */
    .location-card {
      flex-wrap: wrap;
    }

    .map-cue {
      flex-basis: 100%;
      margin-left: calc(46px + 1rem); /* align past the pin icon + gap */
      margin-top: 0.4rem;
      font-size: 0.65rem;
    }

    .hero-social {
      right: 0.75rem;
      gap: 0.5rem;
    }

    .hero-social a {
      width: 32px;
      height: 32px;
    }

    .hero-social svg {
      width: 15px;
      height: 15px;
    }

    .scroll-cue {
      bottom: 0.75rem;
      gap: 0.2rem;
      animation: cueFade 0.8s ease-out 1.4s forwards, cueBounceMobile 2.2s ease-in-out 2.2s infinite;
    }

    .scroll-label {
      font-size: 0.55rem;
      letter-spacing: 0.3em;
    }

    .scroll-cue svg {
      width: 16px;
      height: 16px;
    }

    @keyframes cueBounceMobile {
      0%, 100% { transform: translate(-50%, 0); }
      50% { transform: translate(-50%, 4px); }
    }
  }
</style>

<script>
  // Hide the scroll cue once the user starts scrolling
  const cue = document.querySelector('.scroll-cue');
  if (cue) {
    const toggleCue = () => {
      cue.classList.toggle('cue-hidden', window.scrollY > 30);
    };
    window.addEventListener('scroll', toggleCue, { passive: true });
    toggleCue();
  }

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('anim-fade');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15 }
  );

  document.querySelectorAll('.locations .anim-fade').forEach((el) => {
    el.classList.remove('anim-fade');
    el.setAttribute('data-animate', '');
    observer.observe(el);
  });

  document.querySelectorAll('[data-animate]').forEach((el) => {
    const obs = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          el.classList.add('anim-fade');
          obs.unobserve(el);
        }
      },
      { threshold: 0.15 }
    );
    obs.observe(el);
  });
</script>
</html>
